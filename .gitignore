kafaa_app/.dart_tool/
kafaa_app/.flutter-plugins
kafaa_app/.flutter-plugins-dependencies
kafaa_app/.pub/
kafaa_app/.pub-cache/
/tools/safari-preview/
/.local/

/supabase/.temp/

